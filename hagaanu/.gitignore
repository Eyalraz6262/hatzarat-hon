# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
# Android signing. EAS keeps the upload key for you; if you ever generate one
# locally, losing it is recoverable and committing it is not.
*.keystore
*.jks
# Dropped in by the Firebase/Play consoles. Not secret in the strictest sense,
# but they identify the project and have no business in a public repo.
google-services.json
GoogleService-Info.plist
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — holds the Google Maps key, see .env.example
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Seeded design-canvas build output (~2.5MB). Regenerated from the
# .dc.html sources in design/; the published canvas is the shared copy.
design/*-screens.html

# Agent skill packs installed for development (npx skills). Tooling for whoever
# is writing the code, not part of the app.
.agents/
.claude/
skills-lock.json

# The single-file web demo, built by scripts/bundle-web.py from an
# `expo export --platform web`. Regenerable, and 2MB of it is a base64 copy
# of the fonts and the alarm sounds.
docs/app-demo.html
scripts/network.json
